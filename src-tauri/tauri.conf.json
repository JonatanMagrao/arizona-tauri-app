{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arizona-app",
  "version": "2.3.2",
  "identifier": "com.pc.arizona-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arizona Login",
        "width": 420,
        "height": 560,
        "center": true,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#111316",
        "visible": false
      },
      {
        "label": "app",
        "title": "Arizona App",
        "width": 440,
        "height": 232,
        "center": true,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#111316",
        "visible": false
      },
      {
        "label": "secondary",
        "title": "Arizona",
        "width": 950,
        "height": 650,
        "minWidth": 560,
        "minHeight": 420,
        "parent": "app",
        "center": true,
        "resizable": true,
        "minimizable": false,
        "maximizable": true,
        "closable": true,
        "decorations": false,
        "backgroundColor": "#111316",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://nizchnscqkixawqxrwzd.supabase.co; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/arizona_icon.ico"
    ],
    "resources": {
      "../INSTALLER/scripts": "installer/scripts",
      "../INSTALLER/payload": "installer/payload",
      "../INSTALLER/cep-trusted-cert.json": "installer/cep-trusted-cert.json"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "compression": "lzma",
        "startMenuFolder": "Arizona",
        "installerHooks": "../INSTALLER/nsis/hooks.nsh",
        "template": "../INSTALLER/nsis/installer.nsi"
      }
    }
  }
}
