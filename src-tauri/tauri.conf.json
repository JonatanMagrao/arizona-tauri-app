{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arizona-app",
  "version": "1.5.1",
  "identifier": "com.pc.arizona-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arizona App",
        "width": 570,
        "height": 270,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/arizona_icon.ico"
    ],
    "resources": {
      "src-python/": "src-python/",
      "../.venv/Include/": "src-python/.venv/Include/",
      "../.venv/Lib/": "src-python/.venv/Lib/"
    }
  }
}