{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arizona-app",
  "version": "2.0.0",
  "identifier": "com.pc.arizona-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arizona App",
        "width": 570,
        "height": 270,
        "center": true,
        "resizable": false
      },
      {
        "label": "secondary",
        "title": "Arizona",
        "width": 950,
        "height": 600,
        "minWidth": 560,
        "minHeight": 420,
        "parent": "main",
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/arizona_icon.ico"
    ]
  }
}
