{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arizona-app",
  "version": "2.1.0",
  "identifier": "com.pc.arizona-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arizona App",
        "width": 440,
        "height": 210,
        "center": true,
        "resizable": false,
        "decorations": false
      },
      {
        "label": "secondary",
        "title": "Arizona",
        "width": 950,
        "height": 650,
        "minWidth": 560,
        "minHeight": 420,
        "parent": "main",
        "center": true,
        "resizable": true,
        "minimizable": false,
        "maximizable": true,
        "closable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/arizona_icon.ico"
    ]
  }
}
