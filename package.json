{
  "name": "arizona-app",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-isolation=none src/features/auth/loginFlow.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:clean": "cd src-tauri && cargo clean",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cep:dev": "npm --prefix ARIZONA-EXTENSION run dev",
    "cep:build": "npm --prefix ARIZONA-EXTENSION run build",
    "dev:all": "concurrently -k -n tauri,cep -c cyan,magenta \"npm run tauri:dev\" \"npm run cep:dev\"",
    "license:check": "node ADMIN/scripts/check-license-parity.mjs",
    "release:check": "npm run license:check && powershell -NoProfile -ExecutionPolicy Bypass -File INSTALLER/scripts/verify-release.ps1",
    "release:cep": "npm --prefix ARIZONA-EXTENSION run build",
    "release:tauri": "npm run tauri:build",
    "release:collect": "powershell -NoProfile -ExecutionPolicy Bypass -File INSTALLER/scripts/collect-artifacts.ps1",
    "installer:test": "powershell -NoProfile -ExecutionPolicy Bypass -File INSTALLER/tests/run.ps1",
    "release:installer": "npm run release:check && npm run installer:test && npm run release:collect && powershell -NoProfile -ExecutionPolicy Bypass -File INSTALLER/scripts/verify-release.ps1 -RequirePayload && npm run tauri:build",
    "release:all": "powershell -NoProfile -ExecutionPolicy Bypass -File INSTALLER/scripts/build-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.3",
    "jsxbin": "^2.3.0",
    "vite": "^7.0.4"
  }
}
