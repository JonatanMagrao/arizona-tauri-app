# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.venv
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
confidential.md

# Sensitive/local environment files
.env
.env.*
!.env.example
.env.keys
*.key
*.p12
*.pfx
*private*.pem
*private-key*.pem

# Supabase local state and production secrets
ADMIN/supabase/.branches/
ADMIN/supabase/.temp/
ADMIN/supabase/functions/.env.production.local
ADMIN/supabase/functions/.env.*.local
# Backups datados criados pelos keygens antes de rotacionar chave (contem chave privada)
ADMIN/supabase/functions/*.bak.*

# Extensao CEP (ARIZONA-EXTENSION): o .env.production dela nao tem segredo
# (apenas NODE_ENV) e precisa ser versionado apesar do ignore global .env.*
!ARIZONA-EXTENSION/.env.production

# Admin app generated files
ADMIN/node_modules/
ADMIN/dist/
ADMIN/dist-ssr/

# Adobe SDK and compiled After Effects plugins must not be committed
AE-PLUGIN-ARIZONA/sdk/
AE-PLUGIN-ARIZONA/plugin/
AE-PLUGIN-ARIZONA/**/*.aex

# Native build artifacts for the After Effects bridge
AE-PLUGIN-ARIZONA/.vs/
AE-PLUGIN-ARIZONA/**/Debug/
AE-PLUGIN-ARIZONA/**/Release/
AE-PLUGIN-ARIZONA/**/x64/
AE-PLUGIN-ARIZONA/**/*.vcxproj.user

# Generated official installer payload
INSTALLER/payload/*
!INSTALLER/payload/.gitkeep
INSTALLER/logs/
